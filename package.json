{
  "name": "ekips-prime-pro",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "ekips-prime-pro",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ekips-Prime-Pro/Ekips-Prime-Pro-VSCode"
  },
  "bugs": {
    "url": "https://github.com/Ekips-Prime-Pro/Ekips-Prime-Pro-VSCode/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Education"
  ],
  "keywords": [
    "ekips",
    "lego",
    "spike prime",
    "robot",
    "fll"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:ekips",
    "workspaceContains:**/*.ekips"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ekips",
        "aliases": [
          "Ekips Prime Pro",
          "ekips"
        ],
        "extensions": [
          ".ekips"
        ],
        "icon": {
          "light": "./images/file-icon.svg",
          "dark": "./images/file-icon.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ekips",
        "scopeName": "source.ekips",
        "path": "./syntaxes/ekips.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ekips",
        "path": "./snippets/ekips.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "ekips.checkFile",
        "title": "%command.checkFile%",
        "category": "Ekips",
        "icon": "$(check)"
      },
      {
        "command": "ekips.simulate",
        "title": "%command.simulate%",
        "category": "Ekips",
        "icon": "$(play)"
      },
      {
        "command": "ekips.uploadToHub",
        "title": "%command.uploadToHub%",
        "category": "Ekips",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "ekips.restartLanguageServer",
        "title": "%command.restartLanguageServer%",
        "category": "Ekips"
      },
      {
        "command": "ekips.createCopilotInstructions",
        "title": "%command.createCopilotInstructions%",
        "category": "Ekips"
      },
      {
        "command": "ekips.showMenu",
        "title": "%command.showMenu%",
        "category": "Ekips"
      },
      {
        "command": "ekips.openSettings",
        "title": "%command.openSettings%",
        "category": "Ekips"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ekips.checkFile",
          "when": "editorLangId == ekips",
          "group": "navigation@1"
        },
        {
          "command": "ekips.simulate",
          "when": "editorLangId == ekips",
          "group": "navigation@2"
        },
        {
          "command": "ekips.uploadToHub",
          "when": "editorLangId == ekips",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "ekips.checkFile",
          "when": "resourceExtname == .ekips",
          "group": "ekips@1"
        }
      ],
      "editor/context": [
        {
          "command": "ekips.checkFile",
          "when": "editorLangId == ekips",
          "group": "ekips@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ekips.checkFile",
          "when": "editorLangId == ekips"
        },
        {
          "command": "ekips.simulate",
          "when": "editorLangId == ekips"
        },
        {
          "command": "ekips.uploadToHub",
          "when": "editorLangId == ekips"
        }
      ]
    },
    "configuration": {
      "title": "Ekips Prime Pro",
      "properties": {
        "ekips.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.lsp.enabled%"
        },
        "ekips.lsp.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.lsp.path%"
        },
        "ekips.cli.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.cli.path%"
        },
        "ekips.messages.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "de"
          ],
          "enumDescriptions": [
            "%config.messages.language.auto%",
            "English",
            "Deutsch"
          ],
          "default": "auto",
          "description": "%config.messages.language%"
        },
        "ekips.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "%config.trace.server%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile -- --production",
    "compile": "npm run check-types && node esbuild.mjs",
    "check-types": "tsc --noEmit",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint .",
    "test": "node esbuild.mjs && npm run test:unit && npm run test:grammar",
    "test:unit": "tsc -p tsconfig.test.json && node --test \"out/test/unit/**/*.test.js\"",
    "package": "vsce package --no-dependencies",
    "test:grammar": "vscode-tmgrammar-test \"test/grammar/**/*.test.ekips\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "l10n": "./l10n"
}
