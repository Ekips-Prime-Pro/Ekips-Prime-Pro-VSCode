{
  "name": "ekips-prime-pro",
  "displayName": "Ekips Prime Pro",
  "description": "Language support for Ekips Prime Pro (.ekips), the robot language for the LEGO SPIKE Prime hub.",
  "version": "0.1.0",
  "publisher": "ekips-prime-pro",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ekips-Prime-Pro/Ekips-Prime-Pro-VSCode"
  },
  "bugs": {
    "url": "https://github.com/Ekips-Prime-Pro/Ekips-Prime-Pro-VSCode/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Education"
  ],
  "keywords": [
    "ekips",
    "lego",
    "spike prime",
    "robot",
    "fll"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:ekips",
    "workspaceContains:**/*.ekips"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ekips",
        "aliases": [
          "Ekips Prime Pro",
          "ekips"
        ],
        "extensions": [
          ".ekips"
        ],
        "icon": {
          "light": "./images/file-icon.svg",
          "dark": "./images/file-icon.svg"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile -- --production",
    "compile": "npm run check-types && node esbuild.mjs",
    "check-types": "tsc --noEmit",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "tsc -p tsconfig.test.json && node --test out/test/unit/",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
